{
  "automation": {
    "id": "a5",
    "name": "Untitled Automation",
    "status": "draft",
    "settings": {
      "allowReEntry": false,
      "stopOnResponse": false,
      "executionTimezoneEnabled": true,
      "sendWindowEnabled": true,
      "timezone": "Asia/Katmandu",
      "sendWindowStart": "09:00",
      "sendWindowEnd": "17:00",
      "activeDays": [
        true,
        true,
        true,
        true,
        true,
        false,
        false
      ]
    },
    "version": 1,
    "nodes": [
      {
        "id": "trigger-1",
        "type": "trigger:form_submitted",
        "position": { "x": 0, "y": 0 },
        "data": {
          "formType": "cleave",
          "formId": "c2"
        }
      },
      {
        "id": "split-test-1",
        "type": "condition:split_test",
        "position": { "x": 0, "y": 0 },
        "data": {
          "weights": [50, 50],
          "strategy": "even",
          "winnerCriteria": "clicks",
          "notifyMe": true
        }
      },
      {
        "id": "action-email-1",
        "type": "action:send_email",
        "position": { "x": 0, "y": 0 },
        "data": {
          "fromName": "Support Team",
          "fromEmail": "support@example.com",
          "subject": "Welcome to our platform!",
          "message": "<p>Hello! Thanks for signing up.</p>"
        }
      },
      {
        "id": "if-else-1",
        "type": "condition:if_else",
        "position": { "x": 0, "y": 0 },
        "data": {
          "conditions": [
            {
              "field": "first_name",
              "operator": "not_empty"
            }
          ],
          "logicalOperator": "and",
          "trueLabel": "Has Name",
          "falseLabel": "No Name"
        }
      },
      {
        "id": "action-notify-1",
        "type": "action:send_notification",
        "position": { "x": 0, "y": 0 },
        "data": {
          "message": "<p>New sign up with no name!</p>",
          "channels": {
            "email": true,
            "inApp": true,
            "sms": false
          },
          "recipientType": "team",
          "recipientId": "t2"
        }
      },
      {
        "id": "action-update-1",
        "type": "action:update_contact",
        "position": { "x": 0, "y": 0 },
        "data": {
          "field": "tag",
          "value": "active_user"
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "trigger-1",
        "target": "split-test-1"
      },
      {
        "id": "e2",
        "source": "split-test-1",
        "target": "action-email-1",
        "data": { "label": "50%", "isSplitTest": true }
      },
      {
        "id": "e3",
        "source": "split-test-1",
        "target": "if-else-1",
        "data": { "label": "50%", "isSplitTest": true }
      },
      {
        "id": "e4",
        "source": "if-else-1",
        "target": "action-notify-1",
        "data": { "label": "No Name" }
      },
      {
        "id": "e5",
        "source": "if-else-1",
        "target": "action-update-1",
        "data": { "label": "Has Name" }
      }
    ]
  }
}